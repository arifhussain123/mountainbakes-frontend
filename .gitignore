# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# turbo
.turbo/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# firebase deploy cache (firebase.json/.firebaserc/apphosting.yaml ARE committed —
# App Hosting reads them from the uploaded source)
.firebase/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local AI agent tooling (installed per-developer via `npx skills add`)
.agents/
.claude/
skills-lock.json

# Foreign package-manager lockfiles. This repo is pnpm-only (see `packageManager`
# in package.json). Heroku's Node buildpack hard-fails the build when it finds more
# than one lockfile, so an `npm install` run by mistake must not be committable.
package-lock.json
yarn.lock

# Build stamp written by scripts/generate-version.mjs on every build
public/version.json
