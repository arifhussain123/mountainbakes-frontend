# Web app (Next.js) env — copy to .env for local dev.
# On a host set these as config vars instead; nothing here is read by the API repo,
# which has its own .env.example.
#
# EVERY variable here is NEXT_PUBLIC_*, which means it is inlined into the client
# bundle at BUILD time and is visible to anyone who opens devtools. Never put a
# secret in this file — the API's service-role key belongs in the server repo only.
#
# Corollary, and the single most common deploy failure: setting one of these on a
# running host does nothing. Change it, then REBUILD.

# ─── API ──────────────────────────────────────────────────────────────────────
# REQUIRED. Origin of the Express API (mountainbakes-server) — scheme + host, no
# trailing slash, no path: src/lib/api/client.ts concatenates it straight onto
# `/api/...`. The API is a separate process on a separate host; next.config.ts
# proxies nothing, so the browser calls it cross-origin and the API's own
# CORS_ORIGINS must list this app's exact origin.
#
# Unset is a misconfiguration, not a default — /api/* then resolves against this
# app's own origin — a static bundle with nothing under /api at all — so every
# call 404s with an HTML body. src/lib/api/client.ts throws a named error for this.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Supabase (auth) ──────────────────────────────────────────────────────────
# REQUIRED. Project URL — Supabase -> Settings -> API. No trailing slash.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED. The PUBLISHABLE (anon) key — never the secret/service_role one.
# Two names for one value: src/lib/supabase/client.ts reads the _ANON_KEY spelling,
# the newer Supabase tooling emits the _PUBLISHABLE_KEY spelling. Set both to the
# same key until the reader is migrated, or auth breaks on whichever is missing.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
