# Frontend (Next.js) env — copy to frontend/.env.local for local dev.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time; on Heroku
# set them as config vars BEFORE building the web app.

# Express API base URL — scheme + host, NO trailing slash (it is concatenated
# straight onto '/api/...' in src/lib/api/client.ts).
#
# Local dev uses 127.0.0.1, not localhost: the API binds IPv4-only, but "localhost"
# resolves to ::1 first and that connection is refused, which the browser reports as
# a bare "TypeError: Failed to fetch".
#
# The deployed API is the `mountainproject` Heroku app:
#   https://mountainproject-c84e8ec5e300.herokuapp.com
# Because this repo gitignores .env*, that value cannot be committed — set it as a
# config var on the WEB app before building, per DEPLOY.md:
#   heroku config:set -a <web-app> NEXT_PUBLIC_API_URL=https://mountainproject-c84e8ec5e300.herokuapp.com
# and add that web app's origin to CORS_ORIGINS on the API, or every request is
# CORS-blocked (only localhost is allowed implicitly).
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Supabase Auth (public — safe to expose). Project ref: wzjabtuoxrvyareptddq
NEXT_PUBLIC_SUPABASE_URL=https://wzjabtuoxrvyareptddq.supabase.co
# Publishable ("anon") key — Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# This web app's own public URL (used for absolute metadata links)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
