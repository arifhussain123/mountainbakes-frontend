# Frontend (Next.js) env — copy to frontend/.env.local for local dev.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time; on Heroku
# set them as config vars BEFORE building the web app.

# Express API base URL. In production, the deployed server URL (no trailing slash),
# e.g. https://mountain-bakes-api.herokuapp.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase Auth (public — safe to expose). Project ref: wzjabtuoxrvyareptddq
NEXT_PUBLIC_SUPABASE_URL=https://wzjabtuoxrvyareptddq.supabase.co
# Publishable ("anon") key — Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# This web app's own public URL (used for absolute metadata links)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
